{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "groupName": null
    },
    {
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-digest"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions and the SHA-256 of their release files in scripts/deploy/tools.env",
      "managerFilePatterns": ["/^scripts/deploy/tools\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) file=\\S+\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)\\n[A-Z_]+_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ]
    }
  ]
}
