# Exact tool versions and SHA-256 checksums of the release files the scripts download.
# scripts/deploy/lib/tools.sh reads this file; Renovate updates each version together with its digest
# (custom manager in renovate.json, datasource github-release-attachments). Never run a preinstalled copy.

# renovate: datasource=github-release-attachments depName=koalaman/shellcheck file=shellcheck-{version}.linux.x86_64.tar.xz
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# renovate: datasource=github-release-attachments depName=sigstore/cosign file=cosign-linux-amd64
COSIGN_VERSION=v3.1.4
COSIGN_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa

# renovate: datasource=github-release-attachments depName=cli/cli file=gh_{version}_linux_amd64.tar.gz
GH_VERSION=v2.105.0
GH_SHA256=79e7ab5db738c48777b696e374f8b428f0647debfb424f44d2f426370407fe2f

# renovate: datasource=github-release-attachments depName=rhysd/actionlint file=actionlint_{version}_linux_amd64.tar.gz
ACTIONLINT_VERSION=v1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
