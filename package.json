{
  "name": "asset-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "bun install --frozen-lockfile && bunx playwright install chromium firefox webkit",
    "dev": "bun app/cli/dev.ts",
    "seed": "bun app/server/main.ts seed --config dev/config.yaml",
    "verify": "bash scripts/verify.sh",
    "clean": "bun app/cli/clean.ts",
    "golden:check": "bun app/pipeline/golden-check.ts",
    "size": "bun app/cli/size.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "build:web": "vite build",
    "build:exe": "bun app/cli/build-exe.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@tanstack/react-query": "^5.90.0",
    "busboy": "^1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.83.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "^1.4.5",
    "@types/busboy": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bats": "^1.13.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
